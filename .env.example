# =============================================================================
# LIFEOS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TIMEZONE=Asia/Kolkata

# --- Database ---
# SQLite (default for development)
DATABASE_URL=sqlite+aiosqlite:///./lifeos.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lifeos

# --- Authentication ---
SECRET_KEY=CHANGE_ME_generate_a_secure_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI / LLM Providers (configure at least one) ---
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Active LLM provider: openai | groq | gemini
LLM_PROVIDER=openai

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local

# --- Google OAuth (Calendar & Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/gmail.readonly

# --- Investment / Market Data ---
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# --- Notifications ---
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Resend (alternative)
RESEND_API_KEY=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- File Storage ---
STORAGE_PROVIDER=local
# S3/R2 (optional)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

